VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-auth-domain
VITE_FIREBASE_PROJECT_ID=e-commerce-roshan-enterprises-dhn
VITE_FIREBASE_STORAGE_BUCKET=your-storage-bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Optional Google Cloud Storage upload flow
VITE_GCS_UPLOAD_ENDPOINT=http://localhost:8787/api/gcs/upload-url

# Server-side environment variables for the signed URL API
GCS_BUCKET=your-gcs-bucket-name
GCS_PUBLIC_BASE_URL=https://storage.googleapis.com/your-gcs-bucket-name
CORS_ORIGIN=http://localhost:5173
GCS_SIGNED_URL_TTL_MS=900000
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
